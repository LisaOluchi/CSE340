<%- include('partials/header') %>

<main>
    <h1>Edit Organization</h1>
    
    <% if (locals.errors && errors.length > 0) { %>
        <div class="error-messages">
            <% errors.forEach(error => { %>
                <p class="error"><%= error.msg %></p>
            <% }); %>
        </div>
    <% } %>
    
    <form method="POST" action="/edit-organization/<%= organization.organization_id %>">
        <div>
            <label for="name">Organization Name:</label>
            <input type="text" id="name" name="name" 
                   value="<%= organization.name %>"
                   required maxlength="150">
        </div>
        
        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="description" required><%= organization.description %></textarea>
        </div>
        
        <div>
            <label for="contact_email">Contact Email:</label>
            <input type="email" id="contact_email" name="contact_email"
                   value="<%= organization.contact_email %>"
                   required>
        </div>
        
        <div>
            <label for="logo_filename">Logo Filename:</label>
            <input type="text" id="logo_filename" name="logo_filename"
                   value="<%= organization.logo_filename %>"
                   required>
        </div>
        
        <button type="submit">Save Changes</button>
        <a href="/organizations">Cancel</a>
    </form>
</main>

<%- include('partials/footer') %>