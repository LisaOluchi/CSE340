<%- include('partials/header') %>

<main>
    <h1>Edit Project</h1>
    
    <% if (locals.errors && errors.length > 0) { %>
        <div class="error-messages">
            <% errors.forEach(error => { %>
                <p class="error"><%= error.msg %></p>
            <% }); %>
        </div>
    <% } %>
    
    <form method="POST" action="/edit-project/<%= project.project_id %>">
        <div>
            <label for="title">Project Title:</label>
            <input type="text" id="title" name="title" 
                   value="<%= project.title %>" required maxlength="200">
        </div>
        
        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="description" required maxlength="1000"><%=project.description %></textarea>
        </div>
        
        <div>
            <label for="location">Location:</label>
            <input type="text" id="location" name="location" 
                   value="<%= project.location %>" required maxlength="200">
        </div>
        
        <div>
            <label for="date">Date:</label>
            <input type="date" id="date" name="date" 
                   value="<%= project.date.toISOString().split('T')[0] %>" required>
        </div>
        
        <div>
            <label for="organizationId">Organization:</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">-- Select Organization --</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>"
                            <% if (org.organization_id === project.organization_id) { %>
                                selected
                            <% } %>>
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>
        
        <button type="submit">Save Changes</button>
        <a href="/project/<%= project.project_id %>">Cancel</a>
    </form>
</main>

<%- include('partials/footer') %>