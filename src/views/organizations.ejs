<%- include('partials/header') %>

<main>
    <h1>Our Partner Organizations</h1>
    <ul>
      <% organizations.forEach(org => { %>
        <li>
          <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo" style="width: 100px; height: auto; margin-bottom: 10px;">
          <br>
          <a href="/organization/<%= org.organization_id %>"><%= org.name %></a>
        </li>
      <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>
